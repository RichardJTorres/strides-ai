# Strava API credentials
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# ── HEVY (weightlifting) ──────────────────────────────────────────────────────
# Required for lifting mode. Requires a Hevy Pro subscription.
# Get your key at https://hevy.com/settings?developer
# HEVY_API_KEY=your_hevy_api_key

# ── LLM provider ─────────────────────────────────────────────────────────────
# Set PROVIDER to "claude" (default), "gemini", or "ollama"
PROVIDER=claude

# Claude (default provider)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-opus-4-6
# Optional: how hard the coach thinks per chat request: off, low, medium (default) or high.
# Every provider maps it to the setting its model takes (CLAUDE_THINKING_EFFORT is the old name).
# THINKING_EFFORT=medium

# Gemini
# Get your key at https://aistudio.google.com/apikey
# PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash   # optional, defaults to first model returned by the API

# OpenAI / ChatGPT
# Get your key at https://platform.openai.com/api-keys
# PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o   # optional, defaults to first model returned by the API

# Ollama (local, no API key required)
# Requires Ollama running at the host below with the chosen model pulled.
# PROVIDER=ollama
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434   # optional, this is the default

# Per-turn limits. They are derived from the model's context window and maximum output, so
# this is only for overriding. JSON keys: default, provider, or exact backend label; values:
# round_max_tokens, reply_reserve, turn_output_ceiling, context_target, input_ceiling,
# context_window, tool_rounds, tools, retries, history_messages, recent_activities,
# first_event_s, stream_idle_s, round_deadline_s, reply_deadline_s, turn_deadline_s.
# They may go up or down (past what the model supports they are clamped, with a warning).
# The older names output_tokens, total_output_tokens, input_tokens and rounds still work.
# Example: fewer tool rounds everywhere, and a small local window for Ollama:
# CHAT_LIMITS={"default":{"tool_rounds":3},"ollama":{"round_max_tokens":2000,"context_window":8192}}
